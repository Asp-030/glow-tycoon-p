<script>
// --- 기존 손님 데이터 및 스킨 정보 유지 ---
const PT=[
  {id:1,name:'김지영',concern:'볼 처짐',    fee:110000,sk:'f1'},
  {id:2,name:'박미숙',concern:'목 주름',    fee:140000,sk:'f2',vip:1},
  {id:3,name:'이수진',concern:'턱선 리프팅',fee:120000,sk:'f3'},
  {id:4,name:'최하은',concern:'눈가 탄력',  fee:100000,sk:'f4'},
  {id:5,name:'정태영',concern:'이마 주름',  fee:115000,sk:'m1'},
  {id:6,name:'한소희',concern:'전체 리프팅',fee:160000,sk:'f2',vip:1},
  {id:7,name:'오민지',concern:'입꼬리 처짐',fee:105000,sk:'f3'},
  {id:8,name:'윤채원',concern:'팔자주름',   fee:125000,sk:'f1'},
];
const SK={
  f1:{skin:'#FDD9A8',shade:'#F0C070',hair:'#2A1008',hrhi:'#5A2E14',lip:'#E87090',blush:'rgba(255,130,130,.22)',brow:'#2A1008'},
  f2:{skin:'#F5C87A',shade:'#E0A050',hair:'#5A2E10',hrhi:'#8A4828',lip:'#D06878',blush:'rgba(240,110,90,.18)',brow:'#5A2E10'},
  f3:{skin:'#ECA860',shade:'#D08838',hair:'#180C04',hrhi:'#3C1E0C',lip:'#C05868',blush:'rgba(210,90,70,.15)',brow:'#180C04'},
  f4:{skin:'#FFE0B8',shade:'#F8C898',hair:'#4A2818',hrhi:'#7A4838',lip:'#F090A8',blush:'rgba(255,150,150,.25)',brow:'#4A2818'},
  m1:{skin:'#F0C890',shade:'#DCA868',hair:'#1A0E08',hrhi:'#3A2010',lip:'#B07868',blush:'rgba(190,100,80,.12)',brow:'#1A0E08'},
};

// --- 기존 얼굴 그리기 로직 (그대로 유지) ---
function drawFace(el, sk, state){
  const W=150, H=170;
  el.setAttribute('viewBox',`0 0 ${W} ${H}`);
  el.setAttribute('width','100%'); el.setAttribute('height','100%');
  const c = SK[sk]||SK.f1;
  const cx = 75;
  const clipId = 'cl_'+Math.random().toString(36).slice(2,7);

  const P = {
    f1:{ fcy:84, frx:44, fry:52, eyeY:76, mouthY:108, browY:62, eyeRx:11, eyeRy:9, eyeGap:21, pupilR:4.5, hairStyle:'bob', wrinkle:false, aged:false },
    f2:{ fcy:88, frx:46, fry:54, eyeY:78, mouthY:114, browY:64, eyeRx:10, eyeRy:7.5, eyeGap:22, pupilR:4, hairStyle:'short_gray', wrinkle:true, aged:true },
    f3:{ fcy:82, frx:38, fry:56, eyeY:74, mouthY:106, browY:60, eyeRx:13, eyeRy:11, eyeGap:20, pupilR:5.5, hairStyle:'long', wrinkle:false, aged:false },
    f4:{ fcy:86, frx:48, fry:52, eyeY:78, mouthY:108, browY:64, eyeRx:14, eyeRy:12, eyeGap:20, pupilR:6, hairStyle:'twin_tail', wrinkle:false, aged:false },
    m1:{ fcy:86, frx:46, fry:52, eyeY:76, mouthY:110, browY:62, eyeRx:10, eyeRy:7, eyeGap:22, pupilR:4.5, hairStyle:'male_short', wrinkle:true, aged:false },
  };
  const p = P[sk]||P.f1;
  const {fcy,frx,fry,eyeY,mouthY,browY,eyeRx,eyeRy,eyeGap,pupilR} = p;

  const defs=`<defs><clipPath id="${clipId}"><ellipse cx="${cx}" cy="${fcy}" rx="${frx-1}" ry="${fry-1}"/></clipPath></defs>`;

  let faceShape='';
  if(sk==='m1') faceShape=`<path d="M${cx-frx},${fcy} Q${cx-frx},${fcy+fry*0.3} ${cx-frx*0.6},${fcy+fry*0.82} Q${cx-frx*0.2},${fcy+fry} ${cx},${fcy+fry} Q${cx+frx*0.2},${fcy+fry} ${cx+frx*0.6},${fcy+fry*0.82} Q${cx+frx},${fcy+fry*0.3} ${cx+frx},${fcy} Q${cx+frx},${fcy-fry} ${cx},${fcy-fry} Q${cx-frx},${fcy-fry} ${cx-frx},${fcy} Z" fill="${c.skin}"/>`;
  else if(sk==='f3') faceShape=`<path d="M${cx-frx},${fcy} Q${cx-frx+2},${fcy+fry*0.5} ${cx-8},${fcy+fry*0.95} Q${cx},${fcy+fry+4} ${cx+8},${fcy+fry*0.95} Q${cx+frx-2},${fcy+fry*0.5} ${cx+frx},${fcy} Q${cx+frx},${fcy-fry} ${cx},${fcy-fry} Q${cx-frx},${fcy-fry} ${cx-frx},${fcy} Z" fill="${c.skin}"/>`;
  else if(sk==='f4') faceShape=`<ellipse cx="${cx}" cy="${fcy+4}" rx="${frx}" ry="${fry-2}" fill="${c.skin}"/>`;
  else faceShape=`<ellipse cx="${cx}" cy="${fcy}" rx="${frx}" ry="${fry}" fill="${c.skin}"/>`;

  const ears=`<ellipse cx="${cx-frx+2}" cy="${fcy+4}" rx="8" ry="${sk==='f3'?11:10}" fill="${c.skin}"/><ellipse cx="${cx+frx-2}" cy="${fcy+4}" rx="8" ry="${sk==='f3'?11:10}" fill="${c.skin}"/><ellipse cx="${cx-frx+2}" cy="${fcy+4}" rx="5" ry="6" fill="${c.shade}"/><ellipse cx="${cx+frx-2}" cy="${fcy+4}" rx="5" ry="6" fill="${c.shade}"/>`;

  let hBack='', hFront='';
  if(p.hairStyle==='male_short'){
    hBack=`<ellipse cx="${cx}" cy="${fcy-22}" rx="${frx+4}" ry="${fry*0.52}" fill="${c.hair}"/>`;
    hFront=`<path d="M${cx-frx+2},${fcy-32} Q${cx-20},${fcy-68} ${cx},${fcy-68} Q${cx+20},${fcy-68} ${cx+frx-2},${fcy-32}" fill="${c.hair}"/><path d="M${cx-frx},${fcy-30} Q${cx-34},${fcy-58} ${cx-18},${fcy-46}" fill="${c.hrhi}" opacity=".35"/>`;
  } else if(p.hairStyle==='long'){
    hBack=`<ellipse cx="${cx}" cy="${fcy-10}" rx="${frx+8}" ry="${fry*0.72}" fill="${c.hair}"/><rect x="${cx-frx-10}" y="${fcy+8}" width="16" height="55" rx="8" fill="${c.hair}"/><rect x="${cx+frx-6}" y="${fcy+8}" width="16" height="55" rx="8" fill="${c.hair}"/>`;
    hFront=`<path d="M${cx-frx+2},${fcy-30} Q${cx-26},${fcy-72} ${cx},${fcy-74} Q${cx+26},${fcy-72} ${cx+frx-2},${fcy-30}" fill="${c.hair}"/><path d="M${cx-frx-2},${fcy-28} Q${cx-40},${fcy-64} ${cx-22},${fcy-50}" fill="${c.hrhi}" opacity=".28"/><path d="M${cx+frx+2},${fcy-28} Q${cx+40},${fcy-64} ${cx+22},${fcy-50}" fill="${c.hrhi}" opacity=".2"/>`;
  } else if(p.hairStyle==='twin_tail'){
    hBack=`<ellipse cx="${cx}" cy="${fcy-10}" rx="${frx+6}" ry="${fry*0.68}" fill="${c.hair}"/><ellipse cx="${cx-frx-8}" cy="${fcy+30}" rx="10" ry="22" fill="${c.hair}"/><ellipse cx="${cx+frx+8}" cy="${fcy+30}" rx="10" ry="22" fill="${c.hair}"/>`;
    hFront=`<path d="M${cx-frx+2},${fcy-30} Q${cx-24},${fcy-70} ${cx},${fcy-72} Q${cx+24},${fcy-70} ${cx+frx-2},${fcy-30}" fill="${c.hair}"/><ellipse cx="${cx-frx+4}" cy="${fcy+8}" rx="6" ry="6" fill="${c.hrhi}" opacity=".7"/><ellipse cx="${cx+frx-4}" cy="${fcy+8}" rx="6" ry="6" fill="${c.hrhi}" opacity=".7"/>`;
  } else if(p.hairStyle==='short_gray'){
    hBack=`<ellipse cx="${cx}" cy="${fcy-14}" rx="${frx+5}" ry="${fry*0.60}" fill="${c.hair}"/><rect x="${cx-frx-3}" y="${fcy+10}" width="11" height="28" rx="5" fill="${c.hair}"/><rect x="${cx+frx-8}" y="${fcy+10}" width="11" height="28" rx="5" fill="${c.hair}"/>`;
    hFront=`<path d="M${cx-frx+2},${fcy-30} Q${cx-24},${fcy-66} ${cx},${fcy-68} Q${cx+24},${fcy-66} ${cx+frx-2},${fcy-30}" fill="${c.hair}"/><path d="M${cx-10},${fcy-68} Q${cx+4},${fcy-65} ${cx+18},${fcy-58}" stroke="#D8D0C0" stroke-width="2.5" fill="none" stroke-linecap="round" opacity=".7"/><path d="M${cx-22},${fcy-62} Q${cx-8},${fcy-60} ${cx+4},${fcy-52}" stroke="#E0D8C8" stroke-width="1.8" fill="none" stroke-linecap="round" opacity=".55"/>`;
  } else {
    hBack=`<ellipse cx="${cx}" cy="${fcy-12}" rx="${frx+6}" ry="${fry*0.70}" fill="${c.hair}"/><rect x="${cx-frx-4}" y="${fcy+12}" width="12" height="36" rx="6" fill="${c.hair}"/><rect x="${cx+frx-8}" y="${fcy+12}" width="12" height="36" rx="6" fill="${c.hair}"/>`;
    hFront=`<path d="M${cx-frx+2},${fcy-30} Q${cx-26},${fcy-68} ${cx},${fcy-70} Q${cx+26},${fcy-68} ${cx+frx-2},${fcy-30}" fill="${c.hair}"/><path d="M${cx-frx},${fcy-28} Q${cx-38},${fcy-60} ${cx-20},${fcy-48}" fill="${c.hrhi}" opacity=".30"/>`;
  }

  let brows='';
  if(sk==='m1') brows=`<path d="M${cx-34},${browY+1} L${cx-12},${browY-3}" stroke="${c.brow}" stroke-width="3.2" fill="none" stroke-linecap="round"/><path d="M${cx+12},${browY-3} L${cx+34},${browY+1}" stroke="${c.brow}" stroke-width="3.2" fill="none" stroke-linecap="round"/>`;
  else if(p.aged) brows=`<path d="M${cx-33},${browY+4} Q${cx-22},${browY} ${cx-12},${browY+3}" stroke="${c.brow}" stroke-width="1.8" fill="none" stroke-linecap="round" opacity=".7"/><path d="M${cx+12},${browY+3} Q${cx+22},${browY} ${cx+33},${browY+4}" stroke="${c.brow}" stroke-width="1.8" fill="none" stroke-linecap="round" opacity=".7"/>`;
  else if(sk==='f3') brows=`<path d="M${cx-30},${browY+1} Q${cx-20},${browY-6} ${cx-10},${browY+1}" stroke="${c.brow}" stroke-width="1.6" fill="none" stroke-linecap="round"/><path d="M${cx+10},${browY+1} Q${cx+20},${browY-6} ${cx+30},${browY+1}" stroke="${c.brow}" stroke-width="1.6" fill="none" stroke-linecap="round"/>`;
  else if(sk==='f4') brows=`<path d="M${cx-27},${browY+2} Q${cx-18},${browY-4} ${cx-10},${browY+2}" stroke="${c.brow}" stroke-width="2" fill="none" stroke-linecap="round"/><path d="M${cx+10},${browY+2} Q${cx+18},${browY-4} ${cx+27},${browY+2}" stroke="${c.brow}" stroke-width="2" fill="none" stroke-linecap="round"/>`;
  else brows=`<path d="M${cx-33},${browY+2} Q${cx-22},${browY-3} ${cx-12},${browY+1}" stroke="${c.brow}" stroke-width="2.2" fill="none" stroke-linecap="round"/><path d="M${cx+12},${browY+1} Q${cx+22},${browY-3} ${cx+33},${browY+2}" stroke="${c.brow}" stroke-width="2.2" fill="none" stroke-linecap="round"/>`;

  const noseScale = sk==='f3'?0.85 : sk==='f4'?1.1 : 1;
  const nose=`<ellipse cx="${cx-4}" cy="${fcy+12}" rx="${3.2*noseScale}" ry="${2*noseScale}" fill="rgba(0,0,0,.09)"/><ellipse cx="${cx+4}" cy="${fcy+12}" rx="${3.2*noseScale}" ry="${2*noseScale}" fill="rgba(0,0,0,.09)"/><path d="M${cx-4},${fcy+10} Q${cx},${fcy+6} ${cx+4},${fcy+10}" stroke="rgba(0,0,0,.09)" stroke-width="1.2" fill="none"/>`;

  const blushRx = sk==='f4'?17 : sk==='f2'?12 : 14;
  const blush=`<ellipse cx="${cx-30}" cy="${eyeY+18}" rx="${blushRx}" ry="8" fill="${c.blush}"/><ellipse cx="${cx+30}" cy="${eyeY+18}" rx="${blushRx}" ry="8" fill="${c.blush}"/>`;

  let wrinkles='';
  if(sk==='f2') wrinkles=`<path d="M${cx-10},${eyeY+8} Q${cx-4},${eyeY+12} ${cx-2},${eyeY+18}" stroke="rgba(0,0,0,.1)" stroke-width="1" fill="none" stroke-linecap="round"/><path d="M${cx+10},${eyeY+8} Q${cx+4},${eyeY+12} ${cx+2},${eyeY+18}" stroke="rgba(0,0,0,.1)" stroke-width="1" fill="none" stroke-linecap="round"/><path d="M${cx-18},${eyeY+18} Q${cx-22},${mouthY-4} ${cx-16},${mouthY+2}" stroke="rgba(0,0,0,.09)" stroke-width="1.2" fill="none" stroke-linecap="round"/><path d="M${cx+18},${eyeY+18} Q${cx+22},${mouthY-4} ${cx+16},${mouthY+2}" stroke="rgba(0,0,0,.09)" stroke-width="1.2" fill="none" stroke-linecap="round"/><ellipse cx="${cx-32}" cy="${mouthY-4}" rx="10" ry="6" fill="rgba(0,0,0,.05)"/><ellipse cx="${cx+32}" cy="${mouthY-4}" rx="10" ry="6" fill="rgba(0,0,0,.05)"/>`;
  else if(sk==='m1') wrinkles=`<path d="M${cx-22},${browY-10} Q${cx},${browY-13} ${cx+22},${browY-10}" stroke="rgba(0,0,0,.1)" stroke-width="1.2" fill="none" stroke-linecap="round"/><path d="M${cx-18},${browY-4}  Q${cx},${browY-7}  ${cx+18},${browY-4}" stroke="rgba(0,0,0,.08)" stroke-width="1" fill="none" stroke-linecap="round"/><ellipse cx="${cx}" cy="${mouthY+8}" rx="18" ry="9" fill="rgba(80,40,20,.07)"/>`;

  function eyePair(happy){
    if(happy){
      const arc = eyeRx*0.9;
      return `<path d="M${cx-eyeGap-arc},${eyeY+2} Q${cx-eyeGap},${eyeY-eyeRy-2} ${cx-eyeGap+arc},${eyeY+2}" stroke="${c.brow}" stroke-width="${sk==='f4'?3.2:2.6}" fill="none" stroke-linecap="round"/><path d="M${cx+eyeGap-arc},${eyeY+2} Q${cx+eyeGap},${eyeY-eyeRy-2} ${cx+eyeGap+arc},${eyeY+2}" stroke="${c.brow}" stroke-width="${sk==='f4'?3.2:2.6}" fill="none" stroke-linecap="round"/>`;
    }
    const ex1=cx-eyeGap, ex2=cx+eyeGap;
    const droop = p.aged ? 2 : 0;
    return `<ellipse cx="${ex1}" cy="${eyeY}" rx="${eyeRx}" ry="${eyeRy}" fill="white"/><ellipse cx="${ex1}" cy="${eyeY+droop*0.3}" rx="${eyeRx*0.65}" ry="${eyeRy*0.82}" fill="${c.brow}"/><ellipse cx="${ex1}" cy="${eyeY+droop*0.3}" rx="${pupilR}" ry="${pupilR*1.05}" fill="#111"/><ellipse cx="${ex1-2}" cy="${eyeY+droop*0.3-2}" rx="1.8" ry="1.8" fill="rgba(255,255,255,.82)"/><path d="M${ex1-eyeRx-1},${eyeY-droop-3} Q${ex1},${eyeY-eyeRy*1.35-droop} ${ex1+eyeRx+1},${eyeY-droop-3}" fill="${c.skin}"/>${sk==='f4'?`<ellipse cx="${ex1}" cy="${eyeY-eyeRy-1}" rx="${eyeRx*0.7}" ry="2" fill="rgba(0,0,0,.12)"/>`:''}<ellipse cx="${ex2}" cy="${eyeY}" rx="${eyeRx}" ry="${eyeRy}" fill="white"/><ellipse cx="${ex2}" cy="${eyeY+droop*0.3}" rx="${eyeRx*0.65}" ry="${eyeRy*0.82}" fill="${c.brow}"/><ellipse cx="${ex2}" cy="${eyeY+droop*0.3}" rx="${pupilR}" ry="${pupilR*1.05}" fill="#111"/><ellipse cx="${ex2+2}" cy="${eyeY+droop*0.3-2}" rx="1.8" ry="1.8" fill="rgba(255,255,255,.82)"/><path d="M${ex2-eyeRx-1},${eyeY-droop-3} Q${ex2},${eyeY-eyeRy*1.35-droop} ${ex2+eyeRx+1},${eyeY-droop-3}" fill="${c.skin}"/>${sk==='f4'?`<ellipse cx="${ex2}" cy="${eyeY-eyeRy-1}" rx="${eyeRx*0.7}" ry="2" fill="rgba(0,0,0,.12)"/>`:''}${p.aged?`<path d="M${ex1+eyeRx},${eyeY} Q${ex1+eyeRx+4},${eyeY+4} ${ex1+eyeRx+2},${eyeY+8}" stroke="rgba(0,0,0,.1)" stroke-width=".9" fill="none"/><path d="M${ex2-eyeRx},${eyeY} Q${ex2-eyeRx-4},${eyeY+4} ${ex2-eyeRx-2},${eyeY+8}" stroke="rgba(0,0,0,.1)" stroke-width=".9" fill="none"/>`:''}`;
  }

  function mouthShape(happy){
    const mw = sk==='f3'?13 : sk==='f4'?14 : sk==='m1'?15 : 12;
    if(happy) return `<path d="M${cx-mw},${mouthY-2} Q${cx},${mouthY+13} ${cx+mw},${mouthY-2}" fill="${c.lip}"/><path d="M${cx-mw+2},${mouthY-1} Q${cx},${mouthY+5} ${cx+mw-2},${mouthY-1}" fill="rgba(255,255,255,.42)"/>`;
    const droop = (p.aged||sk==='m1') ? 3 : 0;
    return `<path d="M${cx-mw},${mouthY-droop} Q${cx},${mouthY+4} ${cx+mw},${mouthY-droop}" stroke="${c.lip}" stroke-width="${sk==='m1'?3:2.6}" fill="none" stroke-linecap="round"/>`;
  }

  let overlay='';
  if(state==='tiger'){
    const sy=eyeY+20, ey2=mouthY-6;
    overlay=`
      <g clip-path="url(#${clipId})">
        <g opacity=".88"><line x1="${cx-34}" y1="${sy}" x2="${cx-12}" y2="${ey2}" stroke="#C81010" stroke-width="2.8" stroke-linecap="round"/><line x1="${cx-34}" y1="${sy}" x2="${cx-12}" y2="${ey2}" stroke="rgba(255,160,160,.5)" stroke-width="1.1" stroke-linecap="round"/><line x1="${cx-28}" y1="${sy+1}" x2="${cx-7}" y2="${ey2-1}" stroke="#C81010" stroke-width="2.0" stroke-linecap="round"/><line x1="${cx-22}" y1="${sy+2}" x2="${cx-2}" y2="${ey2-2}" stroke="#C81010" stroke-width="1.3" stroke-linecap="round" opacity=".65"/></g>
        <g opacity=".88"><line x1="${cx+12}" y1="${sy}" x2="${cx+34}" y2="${ey2}" stroke="#C81010" stroke-width="2.8" stroke-linecap="round"/><line x1="${cx+12}" y1="${sy}" x2="${cx+34}" y2="${ey2}" stroke="rgba(255,160,160,.5)" stroke-width="1.1" stroke-linecap="round"/><line x1="${cx+7}" y1="${sy+1}" x2="${cx+28}" y2="${ey2-1}" stroke="#C81010" stroke-width="2.0" stroke-linecap="round"/><line x1="${cx+2}" y1="${sy+2}" x2="${cx+22}" y2="${ey2-2}" stroke="#C81010" stroke-width="1.3" stroke-linecap="round" opacity=".65"/></g>
      </g>
      <rect x="${cx-46}" y="${H-28}" width="92" height="22" rx="11" fill="#BB1111" stroke="#fff" stroke-width="2" opacity="0.95"/>
      <text x="${cx}" y="${H-13}" text-anchor="middle" font-size="11" fill="white" font-weight="900" font-family="Noto Sans KR">타이거마스크!</text>`;
  } else if(state==='burn'){
    const by=eyeY+18;
    overlay=`
      <g clip-path="url(#${clipId})">
        <ellipse cx="${cx-22}" cy="${by+8}" rx="13" ry="8" fill="rgba(180,45,5,.24)"/><ellipse cx="${cx-20}" cy="${by+14}" rx="9" ry="5.5" fill="rgba(200,60,10,.20)"/><ellipse cx="${cx+20}" cy="${by+6}" rx="12" ry="7.5" fill="rgba(180,45,5,.20)"/><ellipse cx="${cx+18}" cy="${by+13}" rx="8" ry="5" fill="rgba(200,60,10,.17)"/><circle cx="${cx-24}" cy="${by+4}" r="2.8" fill="rgba(255,130,50,.55)"/><circle cx="${cx-14}" cy="${by+18}" r="2.2" fill="rgba(255,130,50,.48)"/><circle cx="${cx+22}" cy="${by+2}" r="2.5" fill="rgba(255,130,50,.50)"/><circle cx="${cx+12}" cy="${by+20}" r="1.8" fill="rgba(255,130,50,.42)"/>
      </g>
      <rect x="${cx-46}" y="${H-28}" width="92" height="22" rx="11" fill="#B83C10" stroke="#fff" stroke-width="2" opacity="0.95"/>
      <text x="${cx}" y="${H-13}" text-anchor="middle" font-size="11" fill="white" font-weight="900" font-family="Noto Sans KR">화상 흔적!</text>`;
  } else if(state==='happy'){
    overlay=`
      <ellipse cx="${cx-30}" cy="${eyeY+18}" rx="15" ry="9" fill="rgba(255,120,120,.28)"/><ellipse cx="${cx+30}" cy="${eyeY+18}" rx="15" ry="9" fill="rgba(255,120,120,.28)"/>
      <ellipse cx="${cx-8}" cy="${fcy-44}" rx="3.5" ry="3.5" fill="#FFD440" opacity=".8"/><ellipse cx="${cx+16}" cy="${fcy-50}" rx="2.5" ry="2.5" fill="#FF7BAC" opacity=".7"/><ellipse cx="${cx+32}" cy="${fcy-38}" rx="2" ry="2" fill="#4ECFA8" opacity=".8"/>`;
  }

  const eyes   = eyePair(state==='happy');
  const mouth_ = mouthShape(state==='happy');

  el.innerHTML = defs + hBack + ears + faceShape + hFront + brows + blush + nose + wrinkles + eyes + mouth_ + overlay;
}

// --- 게임 상태 및 로직 ---
const GOAL=1000000;
let G={};
function initG(){
  G={money:0,rep:60,day:1,illUse:0,cart:null,sel:null,queue:[],done:new Set(),pend:null};
  genQ();
}
function genQ(){
  G.queue=[...PT].sort(()=>Math.random()-.5).slice(0,5);
  G.done=new Set(); G.sel=null; G.cart=null;
}
function illRisk(){return Math.min(80,20+G.illUse*18);}
function fmt(n){const a=Math.abs(Math.round(n));return (n<0?'-':'')+a.toLocaleString('ko-KR');}

function render(){
  document.getElementById('hd-d').textContent=G.day;
  document.getElementById('hd-m').textContent=fmt(G.money);
  document.getElementById('hd-r').textContent=G.rep;

  // 게이지 바 애니메이션
  const mp=Math.min(100,Math.max(0,(G.money/GOAL)*100));
  const rp=Math.min(100,Math.max(0,G.rep));
  document.getElementById('gf-m').style.width=mp+'%';
  document.getElementById('gf-r').style.width=rp+'%';
  document.getElementById('gl-m').textContent=G.money.toLocaleString()+' / '+GOAL.toLocaleString();
  document.getElementById('gl-r').textContent=G.rep+' / 100';

  const risk=illRisk();
  document.getElementById('ill-sub').textContent=`비용 -8,000 / 위험 ${risk}%`;
  
  const wb=document.getElementById('warn-banner');
  if(G.illUse>0){
    wb.style.display='flex';
    document.getElementById('warn-txt').textContent=`불법 카트리지 ${G.illUse}회 누적 (부작용 확률 ${risk}%) 위험!`;
  } else wb.style.display='none';

  const lf=document.getElementById('lf-svg');
  const li=document.getElementById('left-info');
  const lp=document.getElementById('left-panel');
  
  if(G.sel){
    drawFace(lf,G.sel.sk,'normal');
    li.innerHTML=`<div class="pname">${G.sel.name}${G.sel.vip?' <span style="color:var(--ywd)">⭐ VIP</span>':''}</div><div class="ptag">${G.sel.concern}</div><div class="pfee">${fmt(G.sel.fee)}원</div>`;
    lp.style.borderColor = 'var(--pk)'; // 선택 시 테두리 하이라이트
  } else {
    lf.innerHTML=''; li.innerHTML='<div class="ehint">손님을 선택하세요 👇</div>';
    lp.style.borderColor = 'var(--deep)';
  }

  // 아이템 버튼 상태
  document.getElementById('btn-gen').classList.toggle('on',G.cart==='genuine');
  document.getElementById('btn-ill').classList.toggle('on',G.cart==='illegal');
  
  const gb=document.getElementById('go-btn');
  if(G.sel&&G.cart){
    gb.disabled=false;
    gb.textContent='💉 시술 시작!';
    gb.style.animation = 'bounce 0.5s infinite alternate';
  } else {
    gb.disabled=true;
    gb.textContent= !G.sel ? '손님 선택 대기' : '카트리지 선택';
    gb.style.animation = 'none';
  }
  renderQ();
}

function renderQ(){
  const row=document.getElementById('queue-row');
  row.innerHTML='';
  const EMOJ={f1:'👩',f2:'👩‍🦳',f3:'👩‍🦰',f4:'👧',m1:'🧑'};
  G.queue.forEach(p=>{
    const d=document.createElement('div');
    d.className='qc'+(G.sel?.id===p.id?' on':'')+(G.done.has(p.id)?' done':'');
    d.innerHTML=(p.vip?'<div class="qvip">VIP</div>':'')+
      `<div class="qface">${EMOJ[p.sk]||'👤'}</div><div class="qname">${p.name}</div><div class="qcon">${p.concern}</div>`;
    d.onclick=()=>{
      if(!G.done.has(p.id)){
        G.sel=p; G.cart=null; hideRight(); render();
        // 사운드 이펙트 흉내내는 통통 효과
        d.style.transform = 'scale(0.9)';
        setTimeout(()=>d.style.transform='', 100);
      }
    };
    row.appendChild(d);
  });
}

function pickCart(t){
  if(!G.sel) return;
  G.cart=t; 
  render();
}

// 화면 위에 떠오르는 플로팅 텍스트 이펙트
function showFloatingText(text, x, y, isGood) {
  const el = document.createElement('div');
  el.className = 'floating-txt ' + (isGood ? 'f-good' : 'f-bad');
  el.textContent = text;
  el.style.left = x + 'px';
  el.style.top = y + 'px';
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 1200);
}

function doTreat(){
  if(!G.sel||!G.cart)return;
  const p=G.sel, gen=G.cart==='genuine';
  let ok, mD, rD, fst, eff;

  if(gen){
    ok=true; mD=p.fee-20000; rD=p.vip?6:3; fst='happy'; eff='완벽한 리프팅! ✨';
  } else {
    G.illUse++;
    ok=(Math.random()*100)>illRisk();
    if(ok){
      mD=p.fee-8000; rD=1; fst='happy'; eff='운이 좋았어... ⚠️';
    } else {
      fst=Math.random()<0.5?'tiger':'burn';
      mD=-(p.fee*(p.vip?4:3)); rD=p.vip?-35:-22;
      eff=fst==='tiger'?'타이거마스크 발생! 😰':'화상 흔적 발생! 🔥';
    }
  }

  G.money+=mD;
  G.rep=Math.max(0,Math.min(100,G.rep+rD));
  G.done.add(p.id);
  
  // 게임 이펙트 연출
  const btnRect = document.getElementById('go-btn').getBoundingClientRect();
  showFloatingText((mD>=0?'+':'')+fmt(mD), btnRect.left + 20, btnRect.top - 20, ok);

  G.sel=null; G.cart=null;

  // 오른쪽 결과 패널 오픈
  const rightPanel = document.getElementById('right-panel');
  rightPanel.classList.remove('panel-disabled');
  
  const rf=document.getElementById('rf-svg');
  drawFace(rf,p.sk,fst);
  
  document.getElementById('right-info').innerHTML=
    `<div class="pname" style="color:${ok?'var(--mnd)':'var(--rdd)'}">${ok?'✅ 성공!':'❌ 대참사!'}</div>
     <div class="ptag" style="background:${ok?'var(--mn)':'var(--rd)'}; border-color:var(--deep); color:#fff">${eff}</div>`;

  addLog(ok
    ?`✅ ${p.name}님 시술 완료! (+${fmt(mD)} / 평판 +${rD})`
    :`❌ ${p.name}님 의료 사고! (${fmt(mD)} 배상 / 평판 ${rD})`,
    ok?'ok':'bad');

  // 모달 내용 세팅
  let desc='';
  if(ok&&gen)            desc=`${p.name}님이 환하게 웃으며 돌아갔어요!\n정품 카트리지 덕분에 완벽한 리프팅 효과가 나타났습니다.`;
  else if(ok&&!gen)      desc=`이번엔 다행히 괜찮았지만…\n지금 부작용 확률이 ${illRisk()}%까지 올라왔어요.\n계속 불법을 사용하면 정말 위험합니다!`;
  else if(fst==='tiger') desc=`불법 카트리지의 불안정한 에너지가\n피부를 긁으며 볼에 타이거마스크 흉터를 남겼습니다.\n${p.name}님이 매우 화가 났어요.`;
  else                   desc=`불법 카트리지 과열로 ${p.name}님의\n피부에 심각한 화상 흔적이 생겼습니다.\n엄청난 배상금을 지급하고 평판이 크게 떨어졌어요.`;

  const rfw=document.getElementById('r-face-wrap');
  rfw.innerHTML='<svg width="100" height="115" viewBox="0 0 150 170" id="modal-face-svg"></svg>';
  drawFace(document.getElementById('modal-face-svg'), p.sk, fst);

  const rttl = document.getElementById('r-ttl');
  rttl.textContent = ok?'STAGE CLEAR!':'FAILED...';
  rttl.style.background = ok?'var(--mn)':'var(--rd)';
  
  document.getElementById('r-dsc').textContent=desc;
  document.getElementById('r-chips').innerHTML=
    `<span class="cp ${mD>=0?'cpp':'cpn'}">💰 ${mD>=0?'+':''}${fmt(mD)}</span>
     <span class="cp ${rD>=0?'cpp':'cpn'}">⭐ 평판 ${rD>=0?'+':''}${rD}</span>`;

  render();

  const endType=getEndType();
  document._pendingEnd = endType || null;
  
  setTimeout(()=> {
    document.getElementById('r-ov').classList.add('show');
  }, 400); // 딜레이를 주어 플로팅 이펙트를 볼 시간을 제공
}

function getEndType(){
  if(G.money>=GOAL)    return 'win';
  if(G.rep<=0)         return 'rep';
  if(G.money<=-150000) return 'broke';
  return null;
}

function hideRight(){
  const rp = document.getElementById('right-panel');
  rp.classList.add('panel-disabled');
  document.getElementById('rf-svg').innerHTML='';
  document.getElementById('right-info').innerHTML='<div class="ehint">시술 후<br>결과가 표시됩니다</div>';
}

function closeResult(){
  document.getElementById('r-ov').classList.remove('show');
  if(document._pendingEnd){
    const t=document._pendingEnd;
    document._pendingEnd=null;
    setTimeout(()=>showEnd(t),250);
    return;
  }
  // 하루가 끝났는지 체크
  if(G.queue.every(p=>G.done.has(p.id))){
    G.day++;
    setTimeout(()=>{
      genQ(); render();
      addLog(`☀️ DAY ${G.day} 시작! 새로운 손님들이 도착했습니다!`,'warn');
      // 새로운 날 시각적 피드백
      document.body.style.animation = 'pulse-bg 0.5s';
      setTimeout(()=>document.body.style.animation='', 500);
    },300);
  }
}

function showEnd(t){
  const titles={win:'🏆 TYCOON MASTER!', rep:'⛔ GAME OVER : 폐업', broke:'💸 GAME OVER : 파산'};
  const descs={
    win:  `목표 수익 달성!\n\n정품 카트리지를 꾸준히 사용한 덕분에\n환자들의 신뢰를 듬뿍 받는 최고의 클리닉이 되었습니다.\n안전한 시술이 성공의 지름길입니다! ✨`,
    rep:  `불법 카트리지 부작용 사례가 SNS에 폭로되며\n클리닉 평판이 바닥을 쳤습니다.\n\n피해 후기가 확산되어 결국 문을 닫게 되었습니다...`,
    broke:`부작용 배상금이 눈덩이처럼 불어나 파산했습니다.\n\n불법 카트리지로 아낀 푼돈보다\n배상금으로 나간 돈이 훨씬 큽니다.`,
  };
  
  const efw=document.getElementById('e-face-wrap');
  const endSk=['f1','f2','f3','f4','m1'][Math.floor(Math.random()*5)];
  const endState=t==='win'?'happy':(Math.random()<.5?'tiger':'burn');
  efw.innerHTML='<svg width="100" height="115" viewBox="0 0 150 170" id="end-face-svg"></svg>';
  drawFace(document.getElementById('end-face-svg'), endSk, endState);

  const ettl = document.getElementById('e-ttl');
  ettl.textContent = titles[t];
  ettl.style.color = t==='win'?'var(--yw)':'var(--rd)';
  ettl.style.textShadow = `2px 2px 0 var(--deep)`;
  
  document.getElementById('e-dsc').textContent=descs[t];
  document.getElementById('e-btn').className='mbtn game-font'+(t==='win'?' gold':'');
  document.getElementById('e-ov').classList.add('show');
}

function restart(){
  document._pendingEnd=null;
  document.getElementById('e-ov').classList.remove('show');
  document.getElementById('r-ov').classList.remove('show');
  document.getElementById('log-box').innerHTML='';
  hideRight();
  initG(); render();
  addLog('게임을 시작합니다! 정품 카트리지로 최고의 클리닉을 만들어보세요 💪');
}

function addLog(t,cls=''){
  const b=document.getElementById('log-box');
  const d=document.createElement('div');
  d.className='log '+cls+' fadein';d.textContent=t;
  b.prepend(d);
  while(b.children.length>4) b.removeChild(b.lastChild);
}

// 초기 시작
initG(); render();
addLog('게임을 시작합니다! 정품 카트리지로 최고의 클리닉을 만들어보세요 💪');
</script>
</body>
