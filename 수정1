<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GLOW 클리닉 타이쿤</title>
<!-- 팝한 게임 느낌을 위해 폰트 추가 (영문/숫자용 코믹 폰트 + 한글 두꺼운 고딕) -->
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Noto+Sans+KR:wght@700;900&display=swap" rel="stylesheet">
<style>
/* ── 타이쿤 게임 변수 ── */
:root {
  --deep: #2F1B35;     /* 게임 특유의 짙은 네이비/퍼플 외곽선 */
  --pk: #FF5E9C;       /* 메인 핑크 */
  --pkd: #D83C7B;
  --pkl: #FFCBE0;
  --mn: #25D3A5;       /* 민트 (정품/성공) */
  --mnd: #199F7B;
  --mnl: #B9F6E3;
  --yw: #FFCE2E;       /* 옐로우 (경고/포인트) */
  --ywd: #D3A200;
  --rd: #FF4D5B;       /* 레드 (불법/실패) */
  --rdd: #CC2B38;
  --bg: #FFE5F1;
  --panel: #FFFFFF;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; min-height: 100vh;
  font-family: 'Noto Sans KR', sans-serif;
  color: var(--deep);
  /* 게임 바닥/벽지 느낌의 도트 패턴 배경 */
  background-color: var(--bg);
  background-image: radial-gradient(var(--pkl) 20%, transparent 20%), radial-gradient(var(--pkl) 20%, transparent 20%);
  background-size: 30px 30px;
  background-position: 0 0, 15px 15px;
  user-select: none;
}

/* 폰트 혼용 클래스 */
.game-font { font-family: 'Fredoka', 'Noto Sans KR', sans-serif; }

/* ── 상단 HUD 바 (게임 스테이터스) ── */
#hud {
  padding: 16px 20px;
  display: flex; align-items: center; justify-content: space-between;
  position: sticky; top: 0; z-index: 200;
  max-width: 800px; margin: 0 auto;
}
.logo {
  font-size: 26px; font-weight: 900; color: #fff;
  text-shadow: 3px 3px 0 var(--deep), -1px -1px 0 var(--deep), 1px -1px 0 var(--deep), -1px 1px 0 var(--deep), 1px 1px 0 var(--deep);
  transform: rotate(-3deg);
  animation: float 2s ease-in-out infinite;
}
.logo em { color: var(--yw); font-style: normal; }

.hud-right { display: flex; gap: 12px; }

/* 상태 뱃지 (돈, 평판 등) */
.hstat {
  background: var(--panel);
  border: 3px solid var(--deep);
  border-radius: 20px; padding: 6px 14px;
  display: flex; align-items: center; gap: 6px;
  box-shadow: 0 5px 0 var(--deep);
  font-weight: 900;
  transform: translateY(0);
}
.hstat.day-stat { background: var(--yw); }
.hstat .label { font-size: 14px; display: block; line-height: 1; }
.hstat .val { font-size: 18px; line-height: 1; color: var(--deep); font-family: 'Fredoka', sans-serif;}

/* ── 목표 게이지 바 ── */
#goalbar {
  background: var(--deep);
  border-radius: 20px;
  padding: 12px 20px;
  display: flex; gap: 20px;
  max-width: 760px; margin: 0 auto 16px;
  box-shadow: 0 6px 0 rgba(0,0,0,0.15);
  position: sticky; top: 70px; z-index: 199;
}
.gi { flex: 1; }
.gi-lbl {
  font-size: 12px; font-weight: 900; color: #fff;
  display: flex; justify-content: space-between; margin-bottom: 6px;
}
.gi-track {
  height: 16px; background: #563360; border-radius: 10px;
  border: 2px solid #23122A;
  overflow: hidden; position: relative;
}
.gi-fill {
  height: 100%; border-radius: 8px;
  transition: width 0.5s cubic-bezier(.34,1.2,.64,1);
  position: relative; overflow: hidden;
}
/* 게이지 반짝임 효과 */
.gi-fill::after {
  content:''; position: absolute; top:0; left:0; right:0; bottom:0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: shine 2s infinite;
}
.gi-fill.m { background: linear-gradient(180deg, #FFE47A, var(--yw)); }
.gi-fill.r { background: linear-gradient(180deg, #7AFFE0, var(--mn)); }

/* ── 메인 ── */
#main { max-width: 760px; margin: 0 auto; padding: 0 14px 80px; }

/* ── 시술 씬 ── */
#scene {
  display: grid;
  grid-template-columns: 1fr 140px 1fr;
  gap: 16px; align-items: stretch;
  margin-bottom: 20px;
}

/* 게임 카드/아케이드 머신 스타일 패널 */
.face-panel {
  background: var(--panel);
  border-radius: 24px;
  border: 4px solid var(--deep);
  box-shadow: 0 8px 0 var(--deep), 0 12px 24px rgba(47,27,53,.2);
  padding: 16px 12px;
  text-align: center;
  position: relative;
}
.fp-title {
  display: inline-block;
  background: var(--deep); color: #fff;
  font-size: 12px; font-weight: 900;
  padding: 6px 16px; border-radius: 16px;
  position: absolute; top: -16px; left: 50%; transform: translateX(-50%);
  box-shadow: 0 4px 0 rgba(0,0,0,0.2);
}

/* 스포트라이트 배경 */
.face-box {
  display: flex; justify-content: center; margin: 16px 0 12px;
  background: radial-gradient(circle, var(--pkl) 30%, transparent 70%);
  border-radius: 50%;
}
.pname { font-size: 18px; font-weight: 900; color: var(--deep); }
.ptag {
  display: inline-block;
  background: var(--pk); color: #fff; border: 2px solid var(--deep);
  font-size: 11px; font-weight: 900;
  padding: 4px 12px; border-radius: 20px;
  margin-top: 6px;
}
.pfee {
  font-size: 16px; font-weight: 900; color: var(--deep);
  margin-top: 6px;
  background: var(--yw); border: 2px solid var(--deep);
  border-radius: 12px; padding: 4px 12px; display: inline-block;
  font-family: 'Fredoka', sans-serif;
  box-shadow: 0 3px 0 rgba(0,0,0,0.1);
}
.ehint { font-size: 13px; font-weight: 700; color: #9A7B9F; padding: 30px 0; line-height: 1.6; }

/* ── 중앙 패널 (조작부) ── */
#mid-col { display: flex; flex-direction: column; align-items: center; gap: 12px; padding-top: 10px;}

/* 기기 박스 - 타이쿤 아이템 룩 */
.dev-box {
  width: 110px; height: 110px;
  background: #F1DEFA;
  border: 4px solid var(--deep);
  border-radius: 24px;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6px 0 var(--deep), inset 0 4px 0 rgba(255,255,255,0.5);
  animation: float 3s ease-in-out infinite;
}

/* 카트리지 버튼 (3D 게임 버튼) */
.cbt {
  width: 136px; padding: 10px 8px;
  border: 3px solid var(--deep); border-radius: 16px;
  font-family: 'Noto Sans KR', sans-serif; font-size: 13px; font-weight: 900;
  cursor: pointer; text-align: center;
  transition: all 0.1s;
  position: relative;
}
.cbt.gen { background: #D9FFF2; color: var(--mnd); box-shadow: 0 6px 0 var(--mnd); }
.cbt.gen:hover { filter: brightness(1.1); }
.cbt.gen:active, .cbt.gen.on {
  transform: translateY(6px); box-shadow: 0 0px 0 var(--mnd);
  background: var(--mn); color: #fff;
}
.cbt.ill { background: #FFE8EC; color: var(--rdd); box-shadow: 0 6px 0 var(--rdd); }
.cbt.ill:hover { filter: brightness(1.1); }
.cbt.ill:active, .cbt.ill.on {
  transform: translateY(6px); box-shadow: 0 0px 0 var(--rdd);
  background: var(--rd); color: #fff;
}
.cbt-sub { font-size: 10px; font-weight: 700; margin-top: 4px; opacity: 0.8; font-family: 'Fredoka', sans-serif;}

/* 메인 액션 버튼 */
#go-btn {
  width: 136px; padding: 16px 0; margin-top: 4px;
  background: var(--pk); color: #fff;
  border: 4px solid var(--deep); border-radius: 18px;
  font-family: 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 900;
  cursor: pointer;
  box-shadow: 0 8px 0 var(--deep), inset 0 4px 0 rgba(255,255,255,0.3);
  transition: all 0.1s;
  text-shadow: 1px 1px 0 var(--deep);
}
#go-btn:hover:not(:disabled) { background: #FF7FA9; }
#go-btn:active:not(:disabled) {
  transform: translateY(8px); box-shadow: 0 0px 0 var(--deep);
}
#go-btn:disabled {
  background: #C4B5C8; color: #7F7383; border-color: #7F7383;
  box-shadow: 0 4px 0 #7F7383; cursor: not-allowed; text-shadow: none;
  transform: translateY(4px);
}

/* ── 대기줄 (손님 대기석) ── */
#queue-wrap {
  background: var(--mn);
  border: 4px solid var(--deep);
  border-radius: 24px;
  padding: 16px;
  box-shadow: 0 8px 0 var(--mnd);
  margin-bottom: 20px;
}
.queue-title {
  font-size: 14px; font-weight: 900; color: var(--deep);
  margin-bottom: 12px; display: flex; align-items: center; gap: 8px;
  background: #fff; padding: 4px 12px; border-radius: 12px; border: 2px solid var(--deep);
  display: inline-flex;
}
#queue-row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;}

/* 손님 카드 (캐릭터 슬롯) */
.qc {
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  background: #fff; border: 3px solid var(--deep); border-radius: 18px;
  padding: 8px 10px; cursor: pointer; position: relative;
  transition: all 0.15s; min-width: 80px;
  box-shadow: 0 4px 0 rgba(0,0,0,0.15);
}
.qc:hover { filter: brightness(0.95); transform: translateY(-2px); }
.qc.on {
  background: var(--yw); transform: translateY(-6px);
  box-shadow: 0 6px 0 var(--ywd), 0 0 0 4px rgba(255,206,46,0.4);
}
.qc.done { opacity: 0.4; filter: grayscale(1); pointer-events: none; box-shadow: none; transform: translateY(0);}

.qvip {
  position: absolute; top: -10px; right: -8px;
  background: var(--yw); color: var(--deep);
  border: 2px solid var(--deep);
  font-size: 10px; font-weight: 900; font-family: 'Fredoka', sans-serif;
  padding: 3px 8px; border-radius: 10px;
  box-shadow: 0 3px 0 var(--ywd);
  animation: bounce 1s infinite;
}
.qface { font-size: 32px; line-height: 1; }
.qname { font-size: 11px; font-weight: 900; color: var(--deep); }
.qcon { font-size: 10px; color: #666; font-weight: 700; background: #eee; padding: 2px 6px; border-radius: 6px;}

/* ── 위험 배너 (싸이렌) ── */
#warn-banner {
  background: var(--yw);
  border: 3px solid var(--deep); border-radius: 16px;
  padding: 12px 16px; font-size: 13px; color: var(--deep); font-weight: 900;
  display: none; align-items: center; gap: 10px; margin-bottom: 16px;
  box-shadow: 0 4px 0 var(--ywd);
  animation: siren 1s infinite alternate;
}

/* ── 로그 (메시지 보드) ── */
#log-box { display: flex; flex-direction: column; gap: 8px; }
.log {
  font-size: 13px; font-weight: 900;
  padding: 10px 14px; border-radius: 14px;
  border: 3px solid var(--deep);
  background: var(--panel);
  color: var(--deep);
  box-shadow: 0 3px 0 rgba(0,0,0,0.1);
}
.log.ok { background: var(--mnl); }
.log.bad { background: #FFE8EC; color: var(--rdd); }
.log.warn { background: #FFF3C4; }

/* ── 결과/엔딩 모달 (게임 클리어 느낌) ── */
.ov {
  position: fixed; inset: 0;
  background: rgba(47,27,53, 0.7); backdrop-filter: blur(4px);
  display: flex; align-items: center; justify-content: center;
  z-index: 500; opacity: 0; pointer-events: none; transition: opacity 0.2s;
}
.ov.show { opacity: 1; pointer-events: all; }
.modal {
  background: var(--panel);
  border-radius: 32px;
  border: 5px solid var(--deep);
  padding: 30px 24px; max-width: 400px; width: 92%;
  text-align: center;
  transform: scale(0.7) translateY(50px);
  transition: transform 0.3s cubic-bezier(.34,1.5,.64,1);
  box-shadow: 0 15px 0 var(--deep), 0 20px 60px rgba(0,0,0,0.5);
  position: relative;
}
.ov.show .modal { transform: scale(1) translateY(0); }
.m-face-wrap { display: flex; justify-content: center; margin-bottom: 16px; }

/* 별/파티클 장식 */
.m-deco {
  position: absolute; font-size: 30px; animation: bounce 1.5s infinite alternate;
}

.m-ttl {
  font-size: 28px; font-weight: 900; margin-bottom: 12px;
  text-shadow: 2px 2px 0 var(--deep); color: #fff;
}
.m-dsc {
  font-size: 14px; color: var(--deep); line-height: 1.6; font-weight: 700;
  white-space: pre-line; margin-bottom: 20px;
  background: #F1DEFA; border: 2px solid var(--deep); border-radius: 16px; padding: 14px;
}
.m-chips { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 24px; }
.cp {
  font-size: 14px; font-weight: 900; padding: 6px 16px; border-radius: 20px;
  border: 2px solid var(--deep); font-family: 'Fredoka', sans-serif;
}
.cpp { background: var(--mn); color: #fff; box-shadow: 0 3px 0 var(--mnd); }
.cpn { background: var(--rd); color: #fff; box-shadow: 0 3px 0 var(--rdd); }

.mbtn {
  background: var(--pk); color: #fff;
  border: 4px solid var(--deep); border-radius: 18px;
  padding: 14px 40px; font-size: 18px; font-weight: 900;
  cursor: pointer; box-shadow: 0 6px 0 var(--deep);
  transition: all 0.1s; text-shadow: 1px 1px 0 var(--deep);
}
.mbtn:active { transform: translateY(6px); box-shadow: 0 0px 0 var(--deep); }
.mbtn.gold { background: var(--yw); color: var(--deep); text-shadow: none; }

/* ── 애니메이션 & 특수 효과 ── */
@keyframes fadein { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:none} }
@keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }
@keyframes shine { 0%{left:-100%} 100%{left:100%} }
@keyframes siren { 0%{background:var(--yw);} 100%{background:#FF6B6B; color:#fff; border-color:#800;} }
@keyframes popUp { 0%{transform:scale(0.5);opacity:0;} 80%{transform:scale(1.2);opacity:1;} 100%{transform:scale(1);opacity:0;} }

.fadein { animation: fadein 0.3s ease forwards; }

/* 플로팅 텍스트 이펙트 */
.floating-txt {
  position: absolute;
  font-family: 'Fredoka', sans-serif;
  font-size: 24px; font-weight: 900;
  pointer-events: none; z-index: 1000;
  text-shadow: 2px 2px 0 var(--deep), -2px -2px 0 var(--deep), 2px -2px 0 var(--deep), -2px 2px 0 var(--deep);
  animation: floatUp 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}
.f-good { color: var(--mn); }
.f-bad { color: var(--rd); }
@keyframes floatUp {
  0% { transform: translateY(0) scale(0.5); opacity: 0; }
  20% { transform: translateY(-20px) scale(1.2); opacity: 1; }
  80% { transform: translateY(-60px) scale(1); opacity: 1; }
  100% { transform: translateY(-80px) scale(0.8); opacity: 0; }
}

#right-panel { transition: opacity 0.3s, filter 0.3s; }
.panel-disabled { opacity: 0.5; filter: grayscale(0.5); }
</style>
</head>
<body>

<!-- ── HUD (게임 상단 상태바) ── -->
<div id="hud">
  <div class="logo">✨<em>GLOW</em><br>TYCOON</div>
  <div class="hud-right">
    <div class="hstat day-stat" title="현재일차">
      <span class="label">DAY</span>
      <span class="val" id="hd-d">1</span>
    </div>
    <div class="hstat" title="수익">
      <span class="label">💰</span>
      <span class="val" id="hd-m">0</span>
    </div>
    <div class="hstat" title="평판">
      <span class="label">⭐</span>
      <span class="val" id="hd-r">60</span>
    </div>
  </div>
</div>

<!-- ── 목표 게이지 ── -->
<div id="goalbar">
  <div class="gi">
    <div class="gi-lbl">
      <span>💰 목표 수익</span>
      <span id="gl-m" class="game-font">0 / 1,000,000</span>
    </div>
    <div class="gi-track"><div class="gi-fill m" id="gf-m" style="width:0%"></div></div>
  </div>
  <div class="gi">
    <div class="gi-lbl">
      <span>⭐ 클리닉 평판</span>
      <span id="gl-r" class="game-font">60 / 100</span>
    </div>
    <div class="gi-track"><div class="gi-fill r" id="gf-r" style="width:60%"></div></div>
  </div>
</div>

<!-- ── 메인 게임 영역 ── -->
<div id="main">

  <!-- 시술 씬 -->
  <div id="scene">
    <!-- 왼쪽: 현재 손님 -->
    <div class="face-panel" id="left-panel">
      <div class="fp-title">👤 현재 손님</div>
      <div class="face-box">
        <svg id="lf-svg" width="130" height="150" viewBox="0 0 150 170"></svg>
      </div>
      <div id="left-info">
        <div class="ehint">대기열에서<br>손님을 선택하세요 👇</div>
      </div>
    </div>

    <!-- 중앙: 조작부 (아이템 & 시술버튼) -->
    <div id="mid-col">
      <!-- 기기 아이콘 -->
      <div class="dev-box">
        <svg width="84" height="84" viewBox="0 0 84 84">
          <!-- 기기 본체 통통하게 -->
          <rect x="20" y="8" width="44" height="56" rx="12" fill="#EAD0F8" stroke="var(--deep)" stroke-width="3"/>
          <rect x="28" y="16" width="28" height="20" rx="6" fill="#FFF" stroke="var(--deep)" stroke-width="2"/>
          <circle cx="34" cy="46" r="5" fill="var(--pk)" stroke="var(--deep)" stroke-width="2"/>
          <circle cx="50" cy="46" r="5" fill="var(--mn)" stroke="var(--deep)" stroke-width="2"/>
          <!-- 손잡이 및 팁 -->
          <rect x="38" y="64" width="8" height="12" rx="3" fill="#DDB8F0" stroke="var(--deep)" stroke-width="2"/>
          <circle cx="42" cy="78" r="6" fill="#FFF" stroke="var(--deep)" stroke-width="2"/>
          <circle cx="42" cy="78" r="3" fill="var(--pk)" id="dev-dot"/>
          <!-- 화면 안 표시기 -->
          <path d="M 32 26 L 38 20 L 44 26" fill="none" stroke="var(--pk)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <!-- 카트리지 선택 아이템 슬롯 -->
      <button class="cbt gen" id="btn-gen" onclick="pickCart('genuine')">
        ✨ 정품 카트리지
        <div class="cbt-sub">비용 -20,000 / 안전</div>
      </button>
      <button class="cbt ill" id="btn-ill" onclick="pickCart('illegal')">
        🧨 불법 카트리지
        <div class="cbt-sub" id="ill-sub">비용 -8,000 / 위험 20%</div>
      </button>

      <!-- 시술 시작 버튼 -->
      <button id="go-btn" disabled onclick="doTreat()">시술 시작!</button>
    </div>

    <!-- 오른쪽: 결과 -->
    <div class="face-panel panel-disabled" id="right-panel">
      <div class="fp-title">✨ 시술 결과</div>
      <div class="face-box" style="background: radial-gradient(circle, #EAEAEA 30%, transparent 70%);">
        <svg id="rf-svg" width="130" height="150" viewBox="0 0 150 170"></svg>
      </div>
      <div id="right-info">
        <div class="ehint">시술 후<br>결과가 표시됩니다</div>
      </div>
    </div>
  </div>

  <!-- 대기줄 -->
  <div id="queue-wrap">
    <div class="queue-title">👥 대기 손님 <span style="font-size:11px; font-weight:normal; color:#666;">클릭해서 호출하세요!</span></div>
    <div id="queue-row"></div>
  </div>

  <!-- 위험 배너 (싸이렌) -->
  <div id="warn-banner">🚨 <span id="warn-txt"></span></div>

  <!-- 로그 보드 -->
  <div id="log-box"></div>
</div>

<!-- ── 결과 모달 (스테이지 클리어 느낌) ── -->
<div class="ov" id="r-ov">
  <div class="modal">
    <div class="m-deco" style="top:-15px; left:10px;">✨</div>
    <div class="m-deco" style="top:-15px; right:10px;">✨</div>
    <div class="m-face-wrap" id="r-face-wrap"></div>
    <div class="m-ttl" id="r-ttl" style="background:var(--mn); padding:5px; border-radius:12px; border:3px solid var(--deep);">SUCCESS!</div>
    <div class="m-dsc" id="r-dsc"></div>
